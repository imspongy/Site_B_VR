
; Site B VR: VR settings (boxed, bottom right, clear of Restart Level)
UICTRL "textbox" 1 1 -1 232 166 312 192
        1 ; Transparent Bk
        1 ; Back Lit
        1 ; Back lit offset
        0 0 0; Back lit color
        "VR SETTINGS" ; Initial Text
        14 ; Point Size
        700 ; Weight
        0 255 0 ; Bk Color
        255 255 255 ; FG Color
        0x5 ; DT Flags
        1 ; Draw Border

UICTRL "hotspot" 1 1 1100 232 166 312 192 0
